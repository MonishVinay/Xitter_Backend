# Server
PORT=8080
ENV=development
APP_URL=http://localhost:8080

# PostgreSQL (Primary Relational Store)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/twitter_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis Instance 1: Session Management (Port 6379, Persistence & Non-eviction)
REDIS_SESSION_URL=redis://localhost:6379/0
SESSION_TTL_HOURS=168
COOKIE_NAME=twitter_session
COOKIE_SECRET=change-me-to-a-secure-32-byte-secret-key-1234
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Redis Instance 2: LRU Query Cache (Port 6380, allkeys-lru Eviction)
REDIS_CACHE_URL=redis://localhost:6380/0
CACHE_DEFAULT_TTL_SECONDS=300
FEED_CACHE_TTL_SECONDS=60
USER_CACHE_TTL_SECONDS=900

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Dev / Testing Mode (Allows simulated login without Google credentials)
ENABLE_DEV_AUTH=true
